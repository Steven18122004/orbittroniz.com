{
  "id": "/",
  "name": "Orbittroniz",
  "short_name": "Orbittroniz",
  "description": "Orbittroniz - Free Business Tools, AI Writer, PDF Tools, QR Maker. No Login. Free Forever. 100+ Free Online Tools for Business.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a1224",
  "theme_color": "#7c3aed",
  "categories": ["business", "productivity", "tools", "utilities"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce8e53b7",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [
    {
      "origin": "https://app.orbittroniz.com"
    }
  ],
  "display_override": ["tabbed", "window-controls-overlay", "standalone"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "auto"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "note_taking": {
    "new_note_url": "/?note=new"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "AI Writer",
      "short_name": "AI Writer",
      "description": "Free AI Writer Tool",
      "url": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "PDF Tools",
      "short_name": "PDF Tools",
      "description": "Free PDF Tools",
      "url": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "QR Maker",
      "short_name": "QR Maker",
      "description": "Free QR Maker Tool",
      "url": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+orbittroniz",
      "url": "/?q=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "application/pdf": [".pdf"]
      },
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Orbittroniz - Free Business Tools on Desktop"
    },
    {
      "src": "/screenshot-mobile.png",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Orbittroniz - Free Business Tools on Mobile"
    }
  ],
  "widgets": [
    {
      "name": "Orbittroniz Tools",
